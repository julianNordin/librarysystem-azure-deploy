# Base URL prefixed onto every API request. Leave empty in development —
# the Vite dev server proxies /api to the P1 API (see vite.config.ts), so
# no cross-origin request (and therefore no CORS setup) is needed locally.
# Set this if the API is served from a different origin than the app,
# e.g. in a production deployment.
VITE_API_BASE_URL=
