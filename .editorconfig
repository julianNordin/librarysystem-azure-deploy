root = true

[*]
indent_style = space
# LF, not the API project's crlf: .gitattributes normalises this repository to
# LF, and having the editor write CRLF only for git to convert it back is churn.
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

# Prefer file-scoped namespaces (used throughout this project)
csharp_style_namespace_declarations = file_scoped:warning

# var preferences
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Braces on their own line (Allman style, as used throughout this project)
csharp_new_line_before_open_brace = all

# Naming: private fields use _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers = readonly

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# Web app: the Vite/React convention is two spaces.
[*.{ts,tsx,js,jsx,mjs,cjs,css,html}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

# Bicep follows the same two-space convention as the templates it compiles to.
[*.bicep]
indent_size = 2

[*.bicepparam]
indent_size = 2

[*.ps1]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
